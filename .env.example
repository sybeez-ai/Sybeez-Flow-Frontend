# Backend API Configuration
VITE_BACKEND_URL=http://localhost:8000

# Avatar Generation API (FastAPI)
VITE_AVATAR_API_URL=http://localhost:8000/api/v1/avatar

# Google Sign-In (Web OAuth client ID — same as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Environment
VITE_APP_ENV=development

# Optional — Perplexity (never commit real keys)
VITE_PERPLEXITY_API_KEY=

# Cognito Google login is configured on the backend (.env).
# Frontend callback route: /auth/callback
# Optional override if frontend port differs from backend COGNITO_REDIRECT_URI:
# VITE_COGNITO_REDIRECT_URI=http://localhost:8081/auth/callback

# Preferred API base (alias of VITE_BACKEND_URL — either works)
# VITE_API_URL=http://localhost:8000

# Production: set VITE_APP_ENV=production and point VITE_BACKEND_URL at your API (https://api.example.com)
