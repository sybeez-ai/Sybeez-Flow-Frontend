# Production frontend — copy to `.env.production` before deploy build.
# `npm run build` fails if this points at localhost (safety guard).

VITE_APP_ENV=production
VITE_API_URL=https://flow-api.sybeez.ai
VITE_BACKEND_URL=https://flow-api.sybeez.ai

# Same Web OAuth client ID as backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=

# Optional
# VITE_AVATAR_API_URL=https://flow-api.sybeez.ai/api/v1/avatar
# VITE_BACKEND_WS=wss://flow-api.sybeez.ai
